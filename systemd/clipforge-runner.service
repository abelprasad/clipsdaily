# ClipForge runner — watches the watchlist, records live streams,
# cuts clips on chat spikes, stages them in the queue.
# Installed by install.sh into ~/.config/systemd/user/ (placeholders
# @CLIPFORGE_HOME@ / @CLIPFORGE_VENV@ are substituted at install).
[Unit]
Description=ClipForge runner (record + cut + stage)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@CLIPFORGE_HOME@
Environment=CLIPFORGE_HOME=@CLIPFORGE_HOME@
Environment=PATH=@CLIPFORGE_VENV@/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin:@CLIPFORGE_HOME@/.local/bin
ExecStart=@CLIPFORGE_VENV@/bin/clipforge run
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
